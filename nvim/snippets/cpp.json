      "    vector<size_t> Find(string_view needle, string_view haystack) {",
      "        vector<size_t> v;",
      "",
      "        size_t n = needle.size();",
      "        size_t hn = haystack.size();",
      "",
      "        if (n == 0) {",
      "            v.reserve(hn + 1);",
      "",
      "            for (size_t i = 0; i <= hn; ++i) {",
      "                v.push_back(i);",
      "            }",
      "",
      "            return v;",
      "        }",
      "",
      "        vector<size_t> lps(n);",
      "",
      "        size_t l = 0;",
      "",
      "        for (size_t r = 1; r < n; r++) {",
      "            while (l != 0 && needle[r] != needle[l]) {",
      "                l = lps[l - 1];",
      "            }",
      "",
      "            if (needle[r] == needle[l]) {",
      "                l++;",
      "                lps[r] = l;",
      "            }",
      "        }",
      "",
      "        size_t i = 0;",
      "        size_t j = 0;",
      "",
      "        while (i < hn) {",
      "            if (haystack[i] != needle[j]) {",
      "                if (j == 0) {",
      "                    i++;",
      "                } else {",
      "                    j = lps[j - 1];",
      "                }",
      "            } else {",
      "                i++;",
      "                j++;",
      "",
      "                if (j == n) {",
      "                    v.push_back(i - j);",
      "                    j = lps[j - 1];",
      "                }",
      "            }",
      "        }",
      "",
      "        return v;",
      "    }",
      "};",

      "",
