      "    for (size_t i = 0; i < v.size(); i++) {",
      "        if (i == v.size() - 1) {",
      "            cout << v[i];",
      "        } else {",
      "            cout << v[i] << ' ';",
      "        }",
      "    }",
      "",
      "    return out;",
      "}",
      "",
      "template <typename... Ts>",
      "void debug_out(const std::string_view names, const Ts&... ts) {",
      "    size_t start = 0;",
      "",
      "    const auto print_single = [&names](size_t start, const auto& value) {",
      "        const auto end = names.find(',', start + 1);",
      "        std::cout << value << ' ';",
      "",
      "        return end + 2;",
      "    };",
      "",
      "    ((start = print_single(start, ts)), ...);",
      "}",
      "",
      "#define p(...) debug_out(#__VA_ARGS__, __VA_ARGS__)",
      "",
      "#define ln \"\\n\"",
      "#define cln cout << \"\\n\"",
      "",
      "namespace ZAlgorithm {",
      "    vector<ll> Find(string_view needle, string_view haystack) {",
      "        string combined = string {needle} + \"\\$\" + string {haystack};",
      "        ll n = combined.length();",
      "        ll patternLength = needle.length();",
      "",
      "        vector<ll> z(n);",
      "        ll left = 0, right = 0;",
      "",
      "        for (ll i = 1; i < n; i++) {",
      "            if (i <= right) {",
      "                z[i] = min(right - i + 1, z[i - left]);",
      "            }",
      "",
      "            while (i + z[i] < n && combined[z[i]] == combined[i + z[i]]) {",
      "                z[i]++;",
      "            }",
      "",
      "            if (i + z[i] - 1 > right) {",
      "                left = i;",
      "                right = i + z[i] - 1;",
      "            }",
      "        }",
      "",
      "        vector<ll> matches;",
      "",
      "        for (int i = patternLength + 1; i < n; i++) {",
      "            if (z[i] == patternLength) {",
      "                matches.push_back(i - patternLength - 1);",
      "            }",
      "        }",
      "",
      "        return matches;",
      "    }",
      "}",

      "",
      "void Solve() {",
      "    $0",
      "}",
