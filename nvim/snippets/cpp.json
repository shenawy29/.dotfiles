      "#define ln \"\\n\"",
      "#define cln cout << \"\\n\"",
      "#define SENTINEL LONG_LONG_MAX",
      "",

      "namespace SegmentTree {",
      "    vector<ll> tree {};",
      "    ll orig_size {};",
      "",
      "    ll Merge(ll one, ll two) {",
      "        return min(one, two);",
      "    }",
      "",
      "    void Build(vector<ll>& orig, ll l, ll r, ll node) {",
      "        if (l == r) {",
      "            tree[node] = orig[l];",
      "            return;",
      "        }",
      "",
      "        ll mid = l + (r - l) / 2;",
      "",
      "        SegmentTree::Build(orig, l, mid, 2 * node + 1);",
      "        SegmentTree::Build(orig, mid + 1, r, 2 * node + 2);",
      "",
      "        tree[node] = SegmentTree::Merge(tree[2 * node + 1], tree[2 * node + 2]);",
      "    }",
      "",
      "    void From(vector<ll>& orig) {",
      "        ll tree_size = 1;",
      "        orig_size = orig.size();",
      "",
      "        while (tree_size < orig_size) {",
      "            tree_size *= 2;",
      "        }",
      "",
      "        tree = vector<ll>(2 * tree_size, SENTINEL);",
      "        SegmentTree::Build(orig, 0, orig_size - 1, 0);",
      "    }",
      "",
      "    void _Update(ll l, ll r, ll node, ll idx, ll val) {",
      "        if (l == r) {",
      "            tree[node] = val;",
      "            return;",
      "        }",
      "",
      "        ll mid = l + (r - l) / 2;",
      "",
      "        if (idx <= mid) {",
      "            SegmentTree::_Update(l, mid, 2 * node + 1, idx, val);",
      "        } else {",
      "            SegmentTree::_Update(mid + 1, r, 2 * node + 2, idx, val);",
      "        }",
      "",
      "        tree[node] = SegmentTree::Merge(tree[2 * node + 1], tree[2 * node + 2]);",
      "    }",
      "",
      "    void Update(ll idx, ll val) {",
      "        SegmentTree::_Update(0, orig_size - 1, 0, idx, val);",
      "    }",
      "",
      "    ll _Query(ll l, ll r, ll node, ll lq, ll rq) {",
      "        if (r < lq || l > rq) {",
      "            return SENTINEL;",
      "        }",
      "",
      "        if (lq <= l && r <= rq) {",
      "            return tree[node];",
      "        }",
      "",
      "        ll mid = l + (r - l) / 2;",
      "",
      "        ll left = SegmentTree::_Query(l, mid, 2 * node + 1, lq, rq);",
      "        ll right = SegmentTree::_Query(mid + 1, r, 2 * node + 2, lq, rq);",
      "",
      "        return SegmentTree::Merge(left, right);",
      "    }",
      "",
      "    ll Query(ll l, ll r) {",
      "        return SegmentTree::_Query(0, orig_size - 1, 0, l, r);",
      "    }",
      "",
      "}",

      "",
      "void Solve() {",
      "    $0",
      "}",
      "",
      "int main() {",
      "    ios_base::sync_with_stdio(false), cin.tie(nullptr), cout.tie(nullptr);",
      "    int test_cases = 1;",
      "    // cin >> test_cases;$1",
      "    for (int tc = 1; tc <= test_cases; tc++) {",
      "        // cout << \"Case #\" << tc << \": \";",
      "        Solve();",
